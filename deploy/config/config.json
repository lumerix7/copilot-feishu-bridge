{
  "feishu": {
    "wsAutoReconnect": true,
    "wsLoggerLevel": "debug",
    "wsAgent": {
      "keepAliveMsecs": 90000,
      "maxSockets": 100,
      "maxFreeSockets": 1
    },
    "wsConnectWarnAfterMs": 30000,
    "wsReconnectWarnThreshold": 3,
    "reconnectReadyDebounceMs": 60000,
    "titleMaxLength": 120,
    "sendRetry": {
      "maxAttempts": 5,
      "baseDelayMs": 1000,
      "multiplier": 2,
      "maxDelayMs": 10000
    }
  },
  "copilot": {
    "defaultModel": "claude-sonnet-4.5",
    "outputSoftLimit": 100000,
    "runTimeoutMs": 600000,
    "statusIntervalMs": 60000,
    "streamUpdateIntervalMs": 120
  },
  "session": {
    "listDefaultCount": 20,
    "allDefaultCount": 100
  },
  "project": {
    "allowedRoots": [
      "$HOME"
    ],
    "defaultPath": "$HOME",
    "defaultSearchEnabled": true
  },
  "status": {
    "includeProject": true
  },
  "paths": {
    "storePath": "$HOME/.local/share/copilot-feishu-bridge/bindings.json"
  },
  "commands": {
    "alias": {
      "todo": "todoist-cli"
    },
    "direct": [],
    "map": {}
  }
}
