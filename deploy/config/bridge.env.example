NODE_ENV=production

FEISHU_APP_ID=replace-me
FEISHU_APP_SECRET=replace-me
FEISHU_BOT_OPEN_ID=replace-me
# Optional: send a one-time "Bridge Ready" message after websocket connect and
# outbound Feishu send are both working.
# FEISHU_STARTUP_NOTIFY_CHAT_ID=oc_xxx

BRIDGE_CONFIG_JSON=$HOME/.config/copilot-feishu-bridge/config.json

# Copilot CLI path override (default: auto-detected from @github/copilot package)
# COPILOT_CLI_PATH=/usr/local/bin/copilot

# Optional network/proxy settings for the service.
# HTTP_PROXY=http://127.0.0.1:7897/
# HTTPS_PROXY=http://127.0.0.1:7897/
# NO_PROXY=localhost,127.0.0.1,::1,.feishu.cn,open.feishu.cn
# http_proxy=http://127.0.0.1:7897/
# https_proxy=http://127.0.0.1:7897/
# no_proxy=localhost,127.0.0.1,::1,.feishu.cn,open.feishu.cn
# NODE_EXTRA_CA_CERTS=/path/to/custom-ca.crt
