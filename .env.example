NODE_ENV=development

FEISHU_APP_ID=cli_PLACEHOLDER
FEISHU_APP_SECRET=PLACEHOLDER
FEISHU_BOT_OPEN_ID=ou_PLACEHOLDER

# The bridge uses the local GitHub Copilot CLI for AI requests via the ACP SDK.
# Auth is handled automatically via ~/.copilot/config.json (run `copilot auth login` once).
# Optionally override the CLI path:
# COPILOT_BIN=/opt/node/lib/node_modules/@github/copilot/npm-loader.js

# BRIDGE_CONFIG_JSON=/home/your/.config/copilot-feishu-bridge/config.json
